# One non-blocking yfinance batch request. BIST data can be delayed, so it
# deliberately does not unlock REAL_TIME notifications.
DATA_PROVIDER=batch_yfinance

# The exact WSS endpoint from your dxFeed welcome letter — do not put tokens in it.
DXFEED_WS_URL=
DXFEED_TOKEN=

# Telegram is disabled by default in config.yaml. These values are read only from .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
