# Select `itick` for the documented iTick stock WebSocket adapter.
DATA_PROVIDER=itick

# iTick documents this product-specific WebSocket endpoint and a `token` header.
# Keep the actual key in local .env only; do not commit it.
ITICK_WS_URL=wss://api-free.itick.org/stock
ITICK_API_KEY=

# The exact WSS endpoint from your dxFeed welcome letter — do not put tokens in it.
DXFEED_WS_URL=
DXFEED_TOKEN=

# Telegram is disabled by default in config.yaml. These values are read only from .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
